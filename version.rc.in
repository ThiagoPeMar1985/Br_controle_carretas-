#define PLUGIN_VERSION             @PLUGIN_VERSION_MAJOR@,@PLUGIN_VERSION_MINOR@,@PLUGIN_VERSION_PATCH@,0
#define PLUGIN_VERSION_STR         "@PLUGIN_VERSION_MAJOR@.@PLUGIN_VERSION_MINOR@.@PLUGIN_VERSION_PATCH@.0\0"

#include "winres.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUGIN_VERSION
 PRODUCTVERSION PLUGIN_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x0L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "200004b0"
        BEGIN
            VALUE "CompanyName", "BR Controle de Carretas"
            VALUE "FileDescription", "Plugin para ATS/ETS2: engate e desengate individual de carretas (rodotrem/bitrem)."
            VALUE "FileVersion", PLUGIN_VERSION_STR
            VALUE "InternalName", "br_controle_de_carretas"
            VALUE "LegalCopyright", "(c) 2025 ThiagoPeMar1985 - baseado em ts-extra-utilities (Dario Wouters, MIT)"
            VALUE "OriginalFilename", "br_controle_de_carretas.dll"
            VALUE "ProductName", "BR Controle de Carretas"
            VALUE "ProductVersion", PLUGIN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x2000, 1200
    END
END
